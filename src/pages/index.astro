---
import "../styles/global.css";
import { projectData } from "../data/projects";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Jesús Antulio Jiménez Delgado" />
    <meta
      name="description"
      content="Portafolio profesional y CV personal de Jesús Antulio Jiménez Delgado: desarrollador frontend especializado en Angular, Ionic y Astro."
    />
    <meta name="keywords" content="frontend developer, Angular, Ionic, Astro, JavaScript, TypeScript, web development" />
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content="Jesús A. Jiménez | Frontend Developer" />
    <meta property="og:description" content="Portafolio profesional y CV personal de Jesús Antulio Jiménez Delgado: desarrollador frontend especializado en Angular, Ionic y Astro." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jesús A. Jiménez | Frontend Developer" />
    <meta name="twitter:description" content="Portafolio profesional y CV personal de Jesús Antulio Jiménez Delgado: desarrollador frontend especializado en Angular, Ionic y Astro." />
    <title>Jesús A. Jiménez | Frontend Developer</title>
    <link rel="icon" href="/assets/favicon/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href="https://jesus-antulio.com.mx" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem("theme");
        } catch {
          storedTheme = null;
        }

        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : systemTheme;

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#0b0d10" : "#f6f3ec");
      })();
    </script>
    <script define:vars={{ projectData }} is:inline>
      window.projectData = projectData;
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Navegación principal">
        <a href="#inicio" class="brand" aria-label="Ir al inicio">
          <span class="brand-mark">JA</span>
          <span>
            <strong>Jesús A. Jiménez</strong>
            <small>Frontend Developer</small>
          </span>
        </a>

        <div class="nav-links" id="navLinks">
          <a href="#perfil">Perfil</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#experiencia">Experiencia</a>
          <a href="#habilidades">Habilidades</a>
          <a href="#contacto">Contacto</a>
        </div>

        <div class="nav-actions">
          <button class="icon-button" type="button" id="themeToggle" aria-label="Cambiar tema" aria-pressed="false">
            <i data-lucide="sun" class="theme-icon theme-icon-light"></i>
            <i data-lucide="moon" class="theme-icon theme-icon-dark"></i>
          </button>
          <button class="icon-button menu-toggle" type="button" id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
            <i data-lucide="menu"></i>
          </button>
          <a class="button button-primary nav-cta" href="mailto:jesus_antulio@protonmail.com">
            <i data-lucide="send"></i>
            Hablemos
          </a>
        </div>
      </nav>
    </header>

    <main>
      <section id="inicio" class="hero-section">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="kicker">Desarrollador Frontend | Ingeniería en Sistemas Inteligentes</p>
            <h1>
              Experto en Desarrollo Web
            </h1>
            <p class="hero-lead">
              Soy Jesús Antulio Jiménez Delgado, desarrollador Front-End en San Luis Potosí. Construyo aplicaciones
              dinámicas, responsivas y mantenibles principalmente con Angular, Ionic. 
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#proyectos">
                <i data-lucide="sparkles"></i>
                Ver proyectos
              </a>
              <a class="button button-secondary" href="/assets/docs/cv-jesus-jimenez.pdf" download>
                <i data-lucide="download"></i>
                Descargar CV
              </a>
            </div>

            <div class="metric-grid" aria-label="Resumen profesional">
              <article class="metric-card">
                <strong class="counter" data-target="2" data-suffix="+">0</strong>
                <span>Años creando frontend</span>
              </article>
              <article class="metric-card">
                <strong class="counter" data-target="3">0</strong>
                <span>Roles técnicos</span>
              </article>
              <article class="metric-card">
                <strong class="counter" data-target="8">0</strong>
                <span>Tecnologías clave</span>
              </article>
            </div>
          </div>

          <div class="hero-visual" aria-label="Resumen de stack">
            <canvas id="skillCanvas" aria-hidden="true"></canvas>
            <article class="profile-panel">
              <div class="panel-topline">
                <span>Portfolio 2026</span>
                <strong>Disponible</strong>
              </div>
              <div class="identity-lockup">
                <div class="avatar-orbit">
                  <span>JA</span>
                </div>
                <div>
                  <p>Jesús Antulio Jiménez Delgado</p>
                  <h2>Angular, Ionic y experiencias web.</h2>
                </div>
              </div>
              <div class="stack-cloud">
                <span>Angular</span>
                <span>TypeScript</span>
                <span>Ionic</span>
                <span>Astro</span>
                <span>Tailwind</span>
                <span>APIs</span>
              </div>
              <div class="panel-links">
                <a href="mailto:jesus_antulio@protonmail.com">
                  <i data-lucide="mail"></i>
                  Correo
                </a>
                <a href="tel:+524448288334">
                  <i data-lucide="phone"></i>
                  Teléfono
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="perfil" class="section-band">
        <div class="section-grid">
          <div class="section-heading">
            <p class="eyebrow">Perfil</p>
            <h2>Frontend con criterio visual, arquitectura modular y foco en producto.</h2>
          </div>
          <div class="feature-grid">
            <article class="feature-card">
              <i data-lucide="layout-dashboard"></i>
              <h3>Aplicaciones Angular</h3>
              <p>Interfaces dinámicas con componentes reutilizables, formularios reactivos y flujos claros.</p>
            </article>
            <article class="feature-card">
              <i data-lucide="plug-zap"></i>
              <h3>Integración con APIs</h3>
              <p>Conexión de servicios, manejo de datos y estados de interfaz listos para escenarios reales.</p>
            </article>
            <article class="feature-card">
              <i data-lucide="smartphone"></i>
              <h3>Web y móvil</h3>
              <p>Experiencias multiplataforma con Ionic y Capacitor sin perder consistencia visual.</p>
            </article>
            <article class="feature-card">
              <i data-lucide="gauge"></i>
              <h3>Rendimiento web</h3>
              <p>Landings y sitios con Astro, cuidando carga, claridad y una publicación más ligera.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="proyectos" class="section-band work-section">
        <div class="section-stack">
          <div class="work-heading">
            <div>
              <p class="eyebrow">Proyectos</p>
              <h2>Trabajo seleccionado con una lectura más editorial.</h2>
            </div>
            <p>
              Áreas basadas en experiencia profesional, preparadas para sumar capturas, métricas o enlaces públicos
              cuando estén disponibles.
            </p>
          </div>

          <div class="project-grid" aria-label="Proyectos destacados">
            {
              Object.entries(projectData).map(([key, project], index) => (
                <article class="project-card" data-project-card={key} tabindex="0" aria-label={`Abrir detalles de ${project.title}`}>
                  <div class="project-number">{String(index + 1).padStart(2, "0")}</div>
                  <div class="project-gallery" aria-label={`Galería de ${project.title}`}>
                    <button class="project-image-trigger" type="button" aria-label={`Abrir galería de ${project.title}`}>
                      <img src={project.images[0].src} alt={project.images[0].alt} />
                    </button>
                    <button class="gallery-control gallery-control-prev" type="button" aria-label="Imagen anterior">
                      <i data-lucide="chevron-left"></i>
                    </button>
                    <button class="gallery-control gallery-control-next" type="button" aria-label="Imagen siguiente">
                      <i data-lucide="chevron-right"></i>
                    </button>
                    <div class="gallery-dots" aria-hidden="true"></div>
                  </div>
                  <h3>{project.title}</h3>
                  <p>
                    {project.description.split(", ").slice(0, 2).join(", ")}.
                  </p>
                  <div class="tag-row">
                    {project.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <dialog class="project-modal" id="projectModal" aria-labelledby="projectModalTitle">
        <div class="modal-panel project-modal-panel">
          <div class="modal-header">
            <div>
              <p class="eyebrow" id="projectModalEyebrow">Proyecto</p>
              <h2 id="projectModalTitle"></h2>
            </div>
            <button class="icon-button" type="button" id="projectModalClose" aria-label="Cerrar proyecto">
              <i data-lucide="x"></i>
            </button>
          </div>
          <div class="project-modal-body">
            <button class="modal-gallery-image" type="button" id="projectModalImageButton" aria-label="Abrir imagen en grande">
              <img id="projectModalImage" src="" alt="" />
            </button>
            <div class="project-modal-copy">
              <p id="projectModalDescription"></p>
              <div class="project-detail-list" id="projectModalDetails"></div>
              <div class="tag-row" id="projectModalTags"></div>
            </div>
          </div>
        </div>
      </dialog>

      <dialog class="image-modal" id="imageModal" aria-labelledby="imageModalTitle">
        <div class="image-modal-panel">
          <div class="image-modal-header">
            <h2 id="imageModalTitle"></h2>
            <button class="icon-button" type="button" id="imageModalClose" aria-label="Cerrar galería">
              <i data-lucide="x"></i>
            </button>
          </div>
          <div class="image-viewer">
            <button class="image-nav" type="button" id="imagePrev" aria-label="Imagen anterior">
              <i data-lucide="chevron-left"></i>
            </button>
            <img id="imageModalImage" src="" alt="" />
            <button class="image-nav" type="button" id="imageNext" aria-label="Imagen siguiente">
              <i data-lucide="chevron-right"></i>
            </button>
          </div>
          <p class="image-counter" id="imageCounter"></p>
        </div>
      </dialog>

      <section id="experiencia" class="section-band">
        <div class="section-grid">
          <div class="section-heading sticky-heading">
            <p class="eyebrow">CV</p>
            <h2>Experiencia, educación y evolución técnica.</h2>
            <a class="button button-secondary" href="#contacto">
              <i data-lucide="mail"></i>
              Contactar
            </a>
          </div>
          <div class="timeline">
            <article class="timeline-item">
              <span>2024 - Presente</span>
              <h3>Desarrollador Frontend | FoxCode</h3>
              <p>Aplicaciones web con Angular, interfaces dinámicas, componentes reutilizables, arquitectura modular, control de versiones, apps con Ionic y landings con Astro.</p>
            </article>
            <article class="timeline-item">
              <span>Ago 2022 - Jul 2023</span>
              <h3>Becario | Facultad de Ingeniería, UASLP</h3>
              <p>Mantenimiento preventivo y correctivo de equipos, instalación y actualización de software especializado, y soporte técnico a estudiantes del área civil.</p>
            </article>
            <article class="timeline-item">
              <span>Jul 2022 - May 2023</span>
              <h3>Practicante | Coordinación de Tecnología Educativa, UASLP</h3>
              <p>Videojuegos educativos con JavaScript y jQuery, participando en conceptualización, diseño gráfico y desarrollo funcional.</p>
            </article>
            <article class="timeline-item">
              <span>LICENCIATURA | 2018 - 2023</span>
              <h3>Ingeniería en Sistemas Inteligentes | UASLP</h3>
              <p>Formación profesional en la Facultad de Ingeniería, San Luis Potosí, México.</p>
            </article>
            <div class="secondary-experience-cta">
              <p>
                Además de estos roles técnicos, he sumado experiencia complementaria en atención a clientes, gestión de archivos y procesos administrativos que enriquecen mi perspectiva y habilidades para colaborar en equipos.
              </p>
              <button class="button button-secondary" type="button" id="secondaryExperienceOpen">
                <i data-lucide="layers-3"></i>
                Ver experiencia complementaria
              </button>
            </div>
          </div>
        </div>
      </section>

      <dialog class="experience-modal" id="secondaryExperienceModal" aria-labelledby="secondaryExperienceTitle">
        <div class="modal-panel">
          <div class="modal-header">
            <div>
              <p class="eyebrow">Experiencia complementaria</p>
              <h2 id="secondaryExperienceTitle">Roles que suman contexto.</h2>
            </div>
            <button class="icon-button" type="button" id="secondaryExperienceClose" aria-label="Cerrar experiencia complementaria">
              <i data-lucide="x"></i>
            </button>
          </div>

          <div class="secondary-experience-list">
            <article class="secondary-experience-item">
              <span>Valuador de seguros</span>
              <h3>Atención a asegurados en taller</h3>
              <p>
                Primer contacto con el cliente al llevar su unidad para la valuación de daños, seguimiento del proceso de reparación y entrega final del vehículo.
              </p>
              <div class="tag-row">
                <span>Inventarios</span><span>Bitacoras</span><span>Cotizaciones</span>
              </div>
            </article>
            <article class="secondary-experience-item">
              <span>Archivista</span>
              <h3>Clasificación y archivo de documentos</h3>
              <p>
                Organización de documentos físicos, clasificación, digitalización y gestión de archivos para facilitar su consulta y resguardo. Asi como validar que se siguiera la normatividad de ley de prevencion de lavado de dinero
              </p>
              <div class="tag-row">
                <span>Colaboración</span><span>Organización</span>
              </div>
            </article>
          </div>
        </div>
      </dialog>

      <section id="habilidades" class="section-band skills-section">
        <div class="section-stack">
          <div class="section-heading">
            <p class="eyebrow">Habilidades</p>
            <h2>Herramientas para diseñar, construir y publicar interfaces.</h2>
          </div>
          <div class="skills-grid">
            <span>HTML</span>
            <span>CSS y SCSS</span>
            <span>Angular</span>
            <span>JavaScript</span>
            <span>TypeScript</span>
            <span>Ionic</span>
            <span>Capacitor</span>
            <span>GitLab</span>
            <span>GitHub</span>
            <span>Astro</span>
            <span>Tailwind</span>
            <span>UI responsive</span>
          </div>
        </div>
      </section>

      <section id="contacto" class="contact-section">
        <div class="contact-grid">
          <div>
            <p class="eyebrow">Contacto</p>
            <h2>Convirtamos tu siguiente idea en algo publicable.</h2>
            <p>
              Estoy abierto a oportunidades y proyectos donde pueda aportar desarrollo frontend, integración web,
              soluciones multiplataforma y una experiencia de usuario clara.
            </p>
          </div>
          <div class="contact-links">
            <a href="mailto:jesus_antulio@protonmail.com">
              <i data-lucide="mail"></i>
              jesus_antulio@protonmail.com
            </a>
            <a href="tel:+524448288334">
              <i data-lucide="phone"></i>
              +52 444 828 8334
            </a>
            <a href="https://maps.google.com/?q=San%20Luis%20Potos%C3%AD%2C%20M%C3%A9xico" target="_blank" rel="noreferrer">
              <i data-lucide="map-pin"></i>
              San Luis Potosí, México
            </a>
            <a href="/assets/docs/cv-jesus-jimenez.pdf" download>
              <i data-lucide="download"></i>
              Descargar CV
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2026 Jesús Antulio Jiménez Delgado.</p>
    </footer>

    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline src="/js/script.js"></script>
  </body>
</html>
