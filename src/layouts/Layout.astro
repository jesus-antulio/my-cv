---
import "../styles/global.css";
import "aos/dist/aos.css";
import Analytics from "@vercel/analytics/astro";
import { site } from "../data/site";
import { defaultLang, langPath, languages, toLang, useTranslations } from "../i18n";

const lang = toLang(Astro.currentLocale);
const { meta } = useTranslations(lang);

const pageUrl = (code: typeof lang) => (code === defaultLang ? site.url : `${site.url}${langPath[code]}`);
const canonical = pageUrl(lang);
const profileImage = `${site.url}${site.profileImage}`;
// Imagen para vistas previas al compartir (Open Graph / X), una por idioma.
const socialImage = `${site.url}${site.socialImage[lang]}`;
const themeColor = site.themeColor;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.url}#person`,
      name: site.fullName,
      alternateName: site.shortName,
      jobTitle: meta.role,
      description: meta.personDescription,
      url: site.url,
      image: profileImage,
      email: site.email,
      telephone: site.phoneDisplay,
      address: {
        "@type": "PostalAddress",
        addressLocality: "San Luis Potosí",
        addressCountry: "MX",
      },
      knowsAbout: [
        "Angular",
        "Ionic",
        "Astro",
        "TypeScript",
        "JavaScript",
        "Frontend Development",
        "UI responsive",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      url: canonical,
      name: meta.siteName,
      description: meta.websiteDescription,
      publisher: { "@id": `${site.url}#person` },
      inLanguage: meta.inLanguage,
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content={site.fullName} />
    <meta name="creator" content={site.fullName} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="theme-color" content={themeColor.dark} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={meta.socialImageAlt} />
    <title>{meta.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="alternate icon" href="/assets/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {languages.map((code) => <link rel="alternate" hreflang={code} href={pageUrl(code)} />)}
    <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLang)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <!-- Fija el tema antes del primer pintado: el guardado por el usuario o, por defecto, oscuro. -->
    <script is:inline define:vars={{ themeColor }}>
      (() => {
        let theme = "dark";
        try {
          if (localStorage.getItem("theme") === "light") theme = "light";
        } catch {
          /* sin acceso a localStorage */
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor[theme]);
      })();
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Analytics />
    <slot />

    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script>
      import AOS from "aos";
      import { initCvRegion } from "../scripts/cv-region";
      import { initIcons } from "../scripts/effects";

      initIcons();
      initCvRegion();
      AOS.init({
        duration: 500,
        easing: "ease-out-cubic",
        offset: 40,
        once: true,
        disable: () => window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      });
    </script>
  </body>
</html>
