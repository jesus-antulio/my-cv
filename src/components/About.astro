---
import { features } from "../data/skills";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="perfil" class="section">
  <div class="container section-stack">
    <SectionHeading index="01" label="Perfil" title="Desarrollo FrontEnd con Angular, Ionic y Astro." />

    <div class="feature-grid" data-aos="fade-up">
      {
        features.map((feature, index) => (
          <article class="feature">
            <div class="feature-top">
              <i data-lucide={feature.icon} />
              <span class="mono" aria-hidden="true">
                0{index + 1}
              </span>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Rejilla con líneas compartidas: el hueco de 1px deja ver el color de línea */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
  }

  .feature {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    background: var(--surface);
    transition: background 200ms ease;
  }

  .feature:hover {
    background: var(--surface-2);
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    color: var(--accent);
  }

  .feature-top :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .feature-top .mono {
    color: var(--muted);
  }

  .feature p {
    font-size: 0.94rem;
  }

  @media (max-width: 980px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
