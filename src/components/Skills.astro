---
import { skills } from "../data/skills";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="habilidades" class="section skills-section">
  <div class="container section-stack">
    <SectionHeading
      index="04"
      label="Habilidades"
      title="Herramientas para diseñar, construir y publicar interfaces."
      color="yellow"
    />

    <ul class="skills-grid">
      {
        skills.map((skill, index) => (
          <li data-aos="fade-up" data-aos-delay={(index % 4) * 70}>
            <span class="skill-cell">
              <span class="skill-index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="skill-name">{skill}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills-grid li {
    display: grid;
  }

  .skill-cell {
    display: grid;
    gap: 18px;
    align-content: space-between;
    min-height: 124px;
    border: var(--bw) solid var(--ink);
    border-radius: var(--radius);
    padding: 16px 18px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    cursor: default;
    transition: translate 140ms ease, box-shadow 140ms ease, background 160ms ease, color 160ms ease;
  }

  .skill-index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .skill-name {
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  /* Cada columna toma un color distinto al pasar el cursor */
  .skill-cell:hover {
    box-shadow: var(--shadow);
    color: var(--on-color);
    translate: -3px -3px;
  }

  li:nth-child(4n + 1) .skill-cell:hover {
    background: var(--green);
  }

  li:nth-child(4n + 2) .skill-cell:hover {
    background: var(--yellow);
  }

  li:nth-child(4n + 3) .skill-cell:hover {
    background: var(--lilac);
  }

  li:nth-child(4n + 4) .skill-cell:hover {
    background: var(--orange);
  }

  @media (max-width: 980px) {
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .skill-cell {
      gap: 10px;
      min-height: 92px;
      padding: 12px 14px;
    }
  }
</style>
