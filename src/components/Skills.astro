---
import { skills } from "../data/skills";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="habilidades" class="section skills-section">
  <div class="container section-stack">
    <SectionHeading
      index="04"
      label="Habilidades"
      title="Herramientas para diseñar, construir y publicar interfaces."
      color="yellow"
    />

    <ul class="skills-wall">
      {
        skills.map((skill, index) => (
          <li data-aos="zoom-in" data-aos-delay={index * 40}>
            <span class="skill-chip">{skill}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills-wall {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    border: var(--bw) solid var(--ink);
    border-radius: 999px;
    padding: 10px 26px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: clamp(1.15rem, 2.6vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    cursor: default;
    transition: translate 140ms ease, box-shadow 140ms ease, rotate 200ms ease, background 160ms ease,
      color 160ms ease;
  }

  /* Cada chip se inclina y toma un color distinto al pasar el cursor */
  .skill-chip:hover {
    box-shadow: var(--shadow);
    color: var(--on-color);
    translate: -3px -3px;
  }

  li:nth-child(4n + 1) .skill-chip:hover {
    background: var(--green);
    rotate: -4deg;
  }

  li:nth-child(4n + 2) .skill-chip:hover {
    background: var(--yellow);
    rotate: 3deg;
  }

  li:nth-child(4n + 3) .skill-chip:hover {
    background: var(--lilac);
    rotate: -3deg;
  }

  li:nth-child(4n + 4) .skill-chip:hover {
    background: var(--orange);
    rotate: 4deg;
  }

  @media (max-width: 680px) {
    .skills-wall {
      gap: 10px;
    }

    .skill-chip {
      padding: 7px 18px;
    }
  }
</style>
