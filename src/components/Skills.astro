---
import { useTranslations } from "../i18n";
import SectionHeading from "./ui/SectionHeading.astro";

const t = useTranslations(Astro.currentLocale);
---

<section id={t.sections.skills} class="section">
  <div class="container split">
    <SectionHeading index="04" label={t.skills.label} title={t.skills.title} />

    <ul class="skills-grid" data-aos="fade-up" data-aos-delay="80">
      {
        t.skills.items.map((skill, index) => (
          <li>
            <span class="mono" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            {skill}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }

  /* Rejilla con líneas compartidas, igual que la de Perfil */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0;
    background: var(--line);
    list-style: none;
  }

  .skills-grid li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 16px;
    background: var(--surface);
    font-size: 0.94rem;
    font-weight: 600;
    transition: background 200ms ease, color 200ms ease;
  }

  .skills-grid li:hover {
    background: var(--surface-2);
    color: var(--accent);
  }

  .skills-grid .mono {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
