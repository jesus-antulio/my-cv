---
import { site } from "../data/site";
---

<a
  class="whatsapp-fab"
  href={site.whatsappProjectUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Escribir por WhatsApp"
>
  <i data-lucide="message-circle"></i>
  WhatsApp
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    border-radius: 999px;
    padding: 0 18px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 700;
    animation: pulse-ring 2.4s ease-out infinite;
  }

  @media (max-width: 680px) {
    .whatsapp-fab {
      display: inline-flex;
    }
  }
</style>
