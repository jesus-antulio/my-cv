---
import { site } from "../data/site";
---

<a
  class="whatsapp-fab"
  href={site.whatsappProjectUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Escribir por WhatsApp"
>
  <i data-lucide="message-circle"></i>
  WhatsApp
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: 14px;
    bottom: 16px;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 50px;
    border: var(--bw) solid #111;
    border-radius: 999px;
    padding: 0 18px;
    background: var(--green);
    box-shadow: 4px 4px 0 var(--shadow-color);
    color: #111;
    font-weight: 800;
    animation: bob 2.6s ease-in-out infinite;
  }

  @media (max-width: 680px) {
    .whatsapp-fab {
      display: inline-flex;
    }
  }
</style>
