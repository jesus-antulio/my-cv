---
import { site } from "../data/site";
---

<a
  class="whatsapp-fab"
  href={site.whatsappProjectUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Escribir por WhatsApp"
>
  <i data-lucide="message-circle"></i>
  WhatsApp
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    border-radius: 999px;
    padding: 0 18px;
    background: var(--brand);
    box-shadow: var(--shadow);
    color: var(--brand-ink);
    font-size: 0.92rem;
    font-weight: 700;
  }

  @media (max-width: 680px) {
    .whatsapp-fab {
      display: inline-flex;
    }
  }
</style>
