---
import type { Project } from "../data/projects";

interface Props {
  id: string;
  project: Project;
  index: number;
}

const { id, project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const summary = `${project.description.split(", ").slice(0, 2).join(", ")}.`;
const cover = project.images[0];
---

<article
  class="project-card card"
  data-project-card={id}
  data-aos="fade-up"
  data-aos-delay={(index % 2) * 80}
  tabindex="0"
  aria-label={`Abrir detalles de ${project.title}`}
>
  <div class="project-gallery" aria-label={`Galería de ${project.title}`}>
    <div class="window-bar">
      <span class="mono">proyectos/{number}</span>
      <div class="gallery-dots" aria-hidden="true"></div>
    </div>
    <div class="project-shot">
      <button class="project-image-trigger" type="button" aria-label={`Abrir galería de ${project.title}`}>
        <img src={cover.src} alt={cover.alt ?? `${project.title}: captura 1`} loading="lazy" />
      </button>
      <button class="gallery-control gallery-control-prev" type="button" aria-label="Imagen anterior">
        <i data-lucide="chevron-left"></i>
      </button>
      <button class="gallery-control gallery-control-next" type="button" aria-label="Imagen siguiente">
        <i data-lucide="chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="project-copy">
    <h3>{project.title}</h3>
    <p>{summary}</p>
    <div class="tag-row">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <span class="open-hint" aria-hidden="true">
      Ver detalles
      <i data-lucide="arrow-up-right"></i>
    </span>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 200ms ease, translate 200ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--line-strong);
    translate: 0 -2px;
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line);
    padding: 9px 14px;
    background: var(--surface-2);
    color: var(--muted);
  }

  .window-bar .mono {
    font-size: 0.74rem;
  }

  .gallery-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  /* Los puntos los genera project-gallery.ts */
  .gallery-dots :global(span) {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background 200ms ease;
  }

  .gallery-dots :global(span.is-active) {
    background: var(--accent);
  }

  .project-shot {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .project-image-trigger {
    display: block;
    overflow: hidden;
    width: 100%;
    border: 0;
    padding: 0;
    background: var(--surface-2);
    aspect-ratio: 16 / 10;
    cursor: zoom-in;
  }

  .project-image-trigger:focus-visible {
    outline-offset: -3px;
  }

  .project-image-trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: scale 400ms ease;
  }

  .project-card:hover .project-image-trigger img {
    scale: 1.02;
  }

  .gallery-control {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    backdrop-filter: blur(6px);
    transition: opacity 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .project-card:hover .gallery-control,
  .project-card:focus-within .gallery-control {
    opacity: 1;
  }

  .gallery-control:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .gallery-control-prev {
    left: 10px;
  }

  .gallery-control-next {
    right: 10px;
  }

  .project-copy {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
    padding: 22px 22px 24px;
  }

  .project-copy h3 {
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }

  .project-copy p {
    font-size: 0.94rem;
  }

  .open-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .open-hint :global(svg) {
    transition: translate 200ms ease;
  }

  .project-card:hover .open-hint :global(svg) {
    translate: 2px -2px;
  }

  /* Sin hover (táctil) los controles quedan siempre visibles */
  @media (hover: none) {
    .gallery-control {
      opacity: 1;
    }
  }
</style>
