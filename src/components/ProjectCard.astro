---
import type { Project } from "../data/projects";

interface Props {
  id: string;
  project: Project;
  index: number;
}

const { id, project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const summary = `${project.description.split(", ").slice(0, 2).join(", ")}.`;
const cover = project.images[0];
---

<article
  class="project-card card"
  data-project-card={id}
  tabindex="0"
  aria-label={`Abrir detalles de ${project.title}`}
  data-aos="fade-up"
  data-aos-delay={(index % 2) * 120}
>
  <div class="window-bar">
    <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="window-title">proyecto-{number}</span>
    <span class="open-hint" aria-hidden="true">
      ver detalles <i data-lucide="arrow-up-right"></i>
    </span>
  </div>

  <div class="project-gallery" aria-label={`Galería de ${project.title}`}>
    <button class="project-image-trigger" type="button" aria-label={`Abrir galería de ${project.title}`}>
      <img src={cover.src} alt={cover.alt ?? `${project.title}: captura 1`} loading="lazy" />
    </button>
    <button class="gallery-control gallery-control-prev" type="button" aria-label="Imagen anterior">
      <i data-lucide="chevron-left"></i>
    </button>
    <button class="gallery-control gallery-control-next" type="button" aria-label="Imagen siguiente">
      <i data-lucide="chevron-right"></i>
    </button>
    <div class="gallery-dots" aria-hidden="true"></div>
  </div>

  <div class="project-copy">
    <h3>{project.title}</h3>
    <p>{summary}</p>
    <div class="tag-row">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    overflow: hidden;
    cursor: pointer;
  }

  .open-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--accent);
    opacity: 0;
    translate: -6px 0;
    transition: opacity 200ms ease, translate 200ms ease;
  }

  .open-hint :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .project-card:hover .open-hint,
  .project-card:focus-visible .open-hint {
    opacity: 1;
    translate: 0 0;
  }

  .project-gallery {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    aspect-ratio: 16 / 10;
  }

  /* Línea de escaneo al pasar el cursor */
  .project-gallery::after {
    position: absolute;
    inset: 0 0 auto;
    height: 12%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 28%, transparent), transparent);
    content: "";
    opacity: 0;
    pointer-events: none;
  }

  .project-card:hover .project-gallery::after {
    opacity: 1;
    animation: scan 2.2s linear infinite;
  }

  .project-image-trigger {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }

  .project-image-trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: scale 500ms ease;
  }

  .project-card:hover .project-image-trigger img {
    scale: 1.04;
  }

  .gallery-control {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: var(--accent);
    cursor: pointer;
    opacity: 0;
    backdrop-filter: blur(6px);
    transition: opacity 180ms ease, background 180ms ease, color 180ms ease;
  }

  .gallery-control:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .project-card:hover .gallery-control,
  .project-card:focus-within .gallery-control {
    opacity: 1;
  }

  .gallery-control-prev {
    left: 10px;
  }

  .gallery-control-next {
    right: 10px;
  }

  .gallery-dots {
    position: absolute;
    right: 0;
    bottom: 10px;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 5px;
    pointer-events: none;
  }

  /* Los puntos los genera project-gallery.ts */
  .gallery-dots :global(span) {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--text) 40%, transparent);
    transition: width 200ms ease, background 200ms ease;
  }

  .gallery-dots :global(span.is-active) {
    width: 18px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .project-copy {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 22px;
  }

  .project-copy h3 {
    font-size: 1.2rem;
  }

  .project-copy p {
    font-size: 0.94rem;
  }

  @media (hover: none) {
    .gallery-control,
    .open-hint {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
