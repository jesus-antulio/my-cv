---
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<div class="section-heading" data-aos="fade-up">
  <p class="eyebrow">
    <span>{index}</span>
    <span class="eyebrow-sep" aria-hidden="true">/</span>
    <span>{label}</span>
  </p>
  <h2>{title}</h2>
  <slot />
</div>
