---
interface Props {
  index: string;
  label: string;
  title: string;
  color?: "green" | "yellow" | "lilac" | "orange";
}

const { index, label, title, color = "yellow" } = Astro.props;
---

<div class="section-heading" data-aos="fade-up">
  <p class:list={["sticker", `fill-${color}`]}>
    <span>({index})</span>
    <span>{label}</span>
  </p>
  <h2>{title}</h2>
  <slot />
</div>
