---
import { navLinks, site } from "../data/site";
---

<header class="site-header">
  <nav class="nav-shell container" aria-label="Navegación principal">
    <a href="#inicio" class="brand" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">{site.initials}</span>
      <span class="brand-text">
        <strong>{site.shortName}</strong>
        <small>{site.role}</small>
      </span>
    </a>

    <div class="nav-links" id="navLinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="nav-actions">
      <button class="icon-button" type="button" id="themeToggle" aria-label="Cambiar tema" aria-pressed="true">
        <i data-lucide="sun" class="theme-icon theme-icon-sun"></i>
        <i data-lucide="moon" class="theme-icon theme-icon-moon"></i>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        id="menuToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <i data-lucide="menu"></i>
      </button>
      <a class="button button-primary nav-cta" href={`mailto:${site.email}`}>
        <i data-lucide="send"></i>
        Hablemos
      </a>
    </div>
  </nav>
  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
</header>

<script>
  import { initNav } from "../scripts/nav";
  import { initTheme } from "../scripts/theme";

  initTheme();
  initNav();
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    animation: slide-down 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
  }

  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 800;
    transition: box-shadow 200ms ease, rotate 300ms ease;
  }

  .brand:hover .brand-mark {
    box-shadow: 0 0 22px color-mix(in srgb, var(--accent) 50%, transparent);
    rotate: -6deg;
  }

  .brand-text {
    display: grid;
    line-height: 1.25;
  }

  .brand-text strong {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .brand-text small {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links a {
    position: relative;
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    transition: color 180ms ease, background 180ms ease;
  }

  .nav-links a::after {
    position: absolute;
    right: 12px;
    bottom: 3px;
    left: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    content: "";
    scale: 0 1;
    transform-origin: left;
    transition: scale 220ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="true"] {
    color: var(--accent);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current="true"]::after {
    scale: 1 1;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* En oscuro se ofrece el sol (pasar a claro); en claro, la luna. */
  .theme-icon-moon,
  :global(:root[data-theme="light"]) .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-icon-moon {
    display: inline-block;
  }

  .menu-toggle {
    display: none;
  }

  .scroll-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-2), var(--accent), var(--accent-3));
    box-shadow: 0 0 12px var(--accent);
    scale: 0 1;
    transform-origin: left;
  }

  @media (max-width: 980px) {
    .nav-links {
      position: fixed;
      top: calc(var(--header-height) + 8px);
      right: 12px;
      left: 12px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      padding: 10px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-links.is-open {
      display: flex;
      animation: menu-in 200ms ease both;
    }

    .nav-links a {
      padding: 14px 16px;
    }

    .nav-links a::after {
      display: none;
    }

    .nav-links a::before {
      color: var(--accent);
      content: "> ";
    }

    .menu-toggle {
      display: inline-flex;
    }

    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .brand-text small {
      display: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
</style>
