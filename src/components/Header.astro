---
import { navLinks, site } from "../data/site";
---

<header class="site-header">
  <nav class="nav-shell container box" aria-label="Navegación principal">
    <a href="#inicio" class="brand" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">{site.initials}</span>
      <strong>{site.shortName}</strong>
    </a>

    <div class="nav-links" id="navLinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="nav-actions">
      <button class="icon-button" type="button" id="themeToggle" aria-label="Cambiar tema" aria-pressed="false">
        <i data-lucide="moon" class="theme-icon theme-icon-moon"></i>
        <i data-lucide="sun" class="theme-icon theme-icon-sun"></i>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        id="menuToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <i data-lucide="menu"></i>
      </button>
      <a class="button button-primary nav-cta" href={`mailto:${site.email}`}>
        Hablemos
        <i data-lucide="arrow-up-right"></i>
      </a>
    </div>

    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
  </nav>
</header>

<script>
  import { initNav } from "../scripts/nav";
  import { initTheme } from "../scripts/theme";

  initTheme();
  initNav();
</script>

<style>
  .site-header {
    position: fixed;
    inset: var(--header-offset) 0 auto;
    z-index: 50;
    animation: drop-in 600ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
    pointer-events: none;
  }

  .nav-shell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-height);
    border-radius: 999px;
    padding: 0 10px 0 12px;
    box-shadow: var(--shadow-sm);
    pointer-events: auto;
    transition: box-shadow 200ms ease;
  }

  .site-header.is-scrolled .nav-shell {
    box-shadow: var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: var(--bw) solid var(--ink);
    border-radius: 50%;
    background: var(--green);
    color: var(--on-color);
    font-size: 0.86rem;
    font-weight: 800;
    transition: rotate 300ms ease;
  }

  .brand:hover .brand-mark {
    rotate: 360deg;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-links a {
    border: 2px solid transparent;
    border-radius: 999px;
    padding: 5px 14px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .nav-links a:hover {
    border-color: var(--ink);
  }

  .nav-links a[aria-current="true"] {
    border-color: var(--ink);
    background: var(--yellow);
    color: var(--on-color);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta {
    min-height: 44px;
    box-shadow: none;
  }

  .nav-cta:hover {
    box-shadow: var(--shadow-sm);
  }

  /* En claro se ofrece la luna (pasar a oscuro); en oscuro, el sol. */
  .theme-icon-sun,
  :global(:root[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-sun {
    display: inline-block;
  }

  .menu-toggle {
    display: none;
  }

  /* Progreso de scroll: línea bajo la píldora */
  .scroll-progress {
    position: absolute;
    right: 28px;
    bottom: -9px;
    left: 28px;
    height: 5px;
    border-radius: 5px;
    background: var(--green);
    outline: 2px solid var(--ink);
    opacity: 0;
    scale: 0 1;
    transform-origin: left;
    transition: opacity 200ms ease;
  }

  .site-header.is-scrolled .scroll-progress {
    opacity: 1;
  }

  @media (max-width: 980px) {
    .nav-links {
      position: absolute;
      top: calc(100% + 14px);
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      border: var(--bw) solid var(--ink);
      border-radius: var(--radius);
      padding: 12px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-links.is-open {
      display: flex;
      animation: menu-in 220ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
    }

    .nav-links a {
      padding: 12px 16px;
      font-size: 1.15rem;
      font-weight: 800;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .nav-cta {
      display: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      rotate: -2deg;
      translate: 0 -10px;
    }
  }
</style>
