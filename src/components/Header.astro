---
import { navLinks, site } from "../data/site";

const handle = new URL(site.url).hostname.split(".")[0];
---

<header class="site-header">
  <nav class="nav-shell container" aria-label="Navegación principal">
    <a href="#inicio" class="brand" aria-label={`${site.shortName}: ir al inicio`}>
      <span class="brand-prompt" aria-hidden="true">~/</span>{handle}
    </a>

    <div class="nav-links" id="navLinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="nav-actions">
      <button class="icon-button" type="button" id="themeToggle" aria-label="Cambiar tema" aria-pressed="false">
        <i data-lucide="moon" class="theme-icon theme-icon-moon"></i>
        <i data-lucide="sun" class="theme-icon theme-icon-sun"></i>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        id="menuToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <i data-lucide="menu"></i>
      </button>
      <a class="button button-primary nav-cta" href={`mailto:${site.email}`}>Hablemos</a>
    </div>
  </nav>
  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
</header>

<script>
  import { initNav } from "../scripts/nav";
  import { initTheme } from "../scripts/theme";

  initTheme();
  initNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: border-color 200ms ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .nav-shell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-height);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .brand-prompt {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links a {
    border-radius: 6px;
    padding: 6px 12px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 160ms ease, background 160ms ease;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links a[aria-current="true"] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta {
    min-height: 40px;
  }

  /* En claro se ofrece la luna (pasar a oscuro); en oscuro, el sol. */
  .theme-icon-sun,
  :global(:root:not([data-theme="light"])) .theme-icon-moon {
    display: none;
  }

  :global(:root:not([data-theme="light"])) .theme-icon-sun {
    display: inline-block;
  }

  .menu-toggle {
    display: none;
  }

  /* Progreso de scroll: línea fina en el borde inferior */
  .scroll-progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: left;
  }

  @media (max-width: 900px) {
    .nav-links {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      padding: 8px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-links.is-open {
      display: flex;
      animation: menu-in 180ms ease both;
    }

    .nav-links a {
      padding: 12px 14px;
      font-size: 1rem;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .nav-cta {
      display: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }
</style>
