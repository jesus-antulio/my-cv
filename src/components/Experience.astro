---
import { secondaryExperienceIntro, timeline } from "../data/experience";
import SecondaryExperienceModal from "./SecondaryExperienceModal.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="experiencia" class="section">
  <div class="container section-stack">
    <SectionHeading index="03" label="CV" title="Experiencia, educación y evolución técnica." />

    <ol class="xp-list">
      {
        timeline.map((item, index) => (
          <li class:list={["xp-row", { "is-current": item.current }]} data-aos="fade-up" data-aos-delay={index * 60}>
            <span class="xp-period mono">{item.period}</span>
            <div class="xp-body">
              <h3>
                {item.title}
                {item.current && <span class="role-badge mono">Rol actual</span>}
              </h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="secondary-cta card" data-aos="fade-up">
      <p>{secondaryExperienceIntro}</p>
      <button class="button" type="button" id="secondaryExperienceOpen">
        <i data-lucide="layers"></i>
        Ver experiencia complementaria
      </button>
    </div>
  </div>
</section>

<SecondaryExperienceModal />

<script>
  import { closeDialog, showDialog, wireDialog } from "../scripts/modals";

  const modal = document.querySelector<HTMLDialogElement>("#secondaryExperienceModal");
  const openButton = document.querySelector<HTMLElement>("#secondaryExperienceOpen");

  openButton?.addEventListener("click", () => showDialog(modal));
  wireDialog(modal, document.querySelector("#secondaryExperienceClose"), () =>
    closeDialog(modal, () => openButton?.focus()),
  );
</script>

<style>
  .xp-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .xp-period {
    padding-top: 3px;
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* La línea vertical y el punto de cada entrada */
  .xp-body {
    position: relative;
    display: grid;
    gap: 8px;
    border-left: 1px solid var(--line);
    padding: 0 0 36px 32px;
  }

  .xp-row:last-child .xp-body {
    padding-bottom: 0;
  }

  .xp-body::before {
    position: absolute;
    top: 7px;
    left: -5px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    content: "";
  }

  .xp-row.is-current .xp-body::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .xp-body h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .role-badge {
    border-radius: 6px;
    padding: 2px 8px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .xp-body p {
    max-width: 68ch;
    font-size: 0.96rem;
  }

  .secondary-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: 22px 24px;
  }

  .secondary-cta p {
    max-width: 70ch;
    font-size: 0.94rem;
  }

  .secondary-cta .button {
    flex: 0 0 auto;
  }

  @media (max-width: 760px) {
    .xp-row {
      grid-template-columns: 1fr;
    }

    .xp-period {
      border-left: 1px solid var(--line);
      padding: 0 0 6px 24px;
    }

    .xp-body {
      padding-left: 24px;
    }

    .xp-body::before {
      top: -22px;
    }

    .secondary-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
