---
import { secondaryExperienceIntro, timeline } from "../data/experience";
import SecondaryExperienceModal from "./SecondaryExperienceModal.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="experiencia" class="section">
  <div class="container section-stack">
    <SectionHeading index="03" label="CV" title="Experiencia, educación y evolución técnica." color="orange">
      <a class="button button-secondary" href="#contacto">
        <i data-lucide="mail"></i>
        Contactar
      </a>
    </SectionHeading>

    <ol class="xp-list box">
      {
        timeline.map((item, index) => (
          <li class="xp-row" data-aos="fade-up" data-aos-delay={index * 70}>
            <span class="xp-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="xp-period label">{item.period}</span>
            <div class="xp-body">
              <h3>
                {item.title}
                {item.current && <span class="sticker fill-green role-badge">Rol actual</span>}
              </h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="secondary-cta box fill-yellow" data-aos="fade-up">
      <p>{secondaryExperienceIntro}</p>
      <button class="button" type="button" id="secondaryExperienceOpen">
        <i data-lucide="layers-3"></i>
        Ver experiencia complementaria
      </button>
    </div>
  </div>
</section>

<SecondaryExperienceModal />

<script>
  import { closeDialog, showDialog, wireDialog } from "../scripts/modals";

  const modal = document.querySelector<HTMLDialogElement>("#secondaryExperienceModal");
  const openButton = document.querySelector<HTMLElement>("#secondaryExperienceOpen");

  openButton?.addEventListener("click", () => showDialog(modal));
  wireDialog(modal, document.querySelector("#secondaryExperienceClose"), () =>
    closeDialog(modal, () => openButton?.focus()),
  );
</script>

<style>
  .xp-list {
    display: grid;
    overflow: hidden;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp-row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 220px) minmax(0, 1fr);
    gap: clamp(14px, 3vw, 36px);
    align-items: start;
    padding: clamp(20px, 3vw, 32px);
    transition: padding-left 220ms ease;
  }

  .xp-row + .xp-row {
    border-top: var(--bw) solid var(--ink);
  }

  /* Barrido de color al pasar el cursor */
  .xp-row::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--green);
    content: "";
    scale: 0 1;
    transform-origin: left;
    transition: scale 320ms cubic-bezier(0.6, 0, 0.2, 1);
  }

  .xp-row:hover::before {
    scale: 1 1;
  }

  .xp-row:hover {
    --text: var(--on-color);
    --muted: #2b2a26;
    color: var(--on-color);
    padding-left: calc(clamp(20px, 3vw, 32px) + 10px);
  }

  .xp-row > * {
    position: relative;
    z-index: 1;
  }

  .xp-index {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .xp-period {
    padding-top: 6px;
  }

  .xp-body {
    display: grid;
    gap: 10px;
  }

  .xp-body h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
  }

  .role-badge {
    padding: 2px 12px;
    box-shadow: none;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    animation: wobble 3s ease-in-out infinite;
  }

  .xp-row:hover .role-badge {
    background: var(--yellow);
  }

  .secondary-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 32px;
    align-items: center;
    padding: clamp(20px, 3vw, 32px);
  }

  .secondary-cta p {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .secondary-cta .button {
    background: var(--surface);
    color: var(--text);
  }

  :global(:root[data-theme="dark"]) .secondary-cta .button {
    background: #141414;
    color: #f4f0e6;
  }

  @media (max-width: 860px) {
    .xp-row {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .xp-index {
      grid-row: span 2;
      font-size: 1.8rem;
    }

    .xp-period {
      padding-top: 2px;
    }

    .secondary-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
