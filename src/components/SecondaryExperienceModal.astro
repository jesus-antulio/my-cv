---
import { secondaryExperience } from "../data/experience";
---

<dialog class="modal experience-modal" id="secondaryExperienceModal" aria-labelledby="secondaryExperienceTitle">
  <div class="modal-panel">
    <div class="modal-header">
      <div>
        <p class="eyebrow">// experiencia complementaria</p>
        <h2 id="secondaryExperienceTitle">Roles que suman contexto.</h2>
      </div>
      <button
        class="icon-button"
        type="button"
        id="secondaryExperienceClose"
        aria-label="Cerrar experiencia complementaria"
      >
        <i data-lucide="x"></i>
      </button>
    </div>

    <div class="secondary-experience-list">
      {
        secondaryExperience.map((item) => (
          <article class="secondary-experience-item">
            <span class="secondary-role">{item.role}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="tag-row">
              {item.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<style>
  .secondary-experience-list {
    display: grid;
    gap: 14px;
  }

  .secondary-experience-item {
    display: grid;
    gap: 10px;
    justify-items: start;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 20px;
    background: color-mix(in srgb, var(--bg) 50%, transparent);
  }

  .secondary-role {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .secondary-experience-item p {
    font-size: 0.94rem;
  }
</style>
