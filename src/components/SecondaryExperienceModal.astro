---
import { secondaryExperience } from "../data/experience";
---

<dialog class="modal experience-modal" id="secondaryExperienceModal" aria-labelledby="secondaryExperienceTitle">
  <div class="modal-panel">
    <div class="modal-header">
      <div>
        <p class="sticker fill-lilac">Experiencia complementaria</p>
        <h2 id="secondaryExperienceTitle">Roles que suman contexto.</h2>
      </div>
      <button
        class="icon-button"
        type="button"
        id="secondaryExperienceClose"
        aria-label="Cerrar experiencia complementaria"
      >
        <i data-lucide="x"></i>
      </button>
    </div>

    <div class="secondary-experience-list">
      {
        secondaryExperience.map((item) => (
          <article class="secondary-experience-item">
            <span class="secondary-role label">{item.role}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="tag-row">
              {item.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<style>
  .secondary-experience-list {
    display: grid;
    gap: 14px;
  }

  .secondary-experience-item {
    display: grid;
    gap: 10px;
    justify-items: start;
    border: var(--bw) solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 20px;
    background: var(--bg);
  }

  .secondary-role {
    border-radius: 6px;
    padding: 2px 8px;
    background: var(--ink);
    color: var(--bg);
  }

  .secondary-experience-item p {
    font-size: 0.98rem;
  }
</style>
