---
import { secondaryExperience } from "../data/experience";
---

<dialog class="modal experience-modal" id="secondaryExperienceModal" aria-labelledby="secondaryExperienceTitle">
  <div class="modal-panel">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Experiencia complementaria</p>
        <h2 id="secondaryExperienceTitle">Roles que suman contexto.</h2>
      </div>
      <button
        class="icon-button"
        type="button"
        id="secondaryExperienceClose"
        aria-label="Cerrar experiencia complementaria"
      >
        <i data-lucide="x"></i>
      </button>
    </div>

    <div class="secondary-experience-list">
      {
        secondaryExperience.map((item) => (
          <article class="secondary-experience-item">
            <span class="secondary-role mono">{item.role}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="tag-row">
              {item.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<style>
  .secondary-experience-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .secondary-experience-item {
    display: grid;
    gap: 8px;
    justify-items: start;
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }

  .secondary-experience-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .secondary-role {
    color: var(--accent);
    font-size: 0.74rem;
  }

  .secondary-experience-item p {
    font-size: 0.94rem;
  }

  .secondary-experience-item .tag-row {
    margin-top: 4px;
  }
</style>
