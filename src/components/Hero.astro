---
import { site } from "../data/site";
import { heroPhrases, heroStack, metrics, skills } from "../data/skills";
import Marquee from "./ui/Marquee.astro";

const metricColors = ["yellow", "lilac", "orange"];
---

<section id="inicio" class="hero">
  <div class="container bento">
    <!-- Titular -->
    <div class="cell cell-title box" data-aos="fade-up">
      <p class="label role-line">
        <span class="role-dot" aria-hidden="true"></span>
        <span data-typed data-phrases={JSON.stringify(heroPhrases)}>{heroPhrases[0]}</span><span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <h1>
        Experto en <br />
        <span class="marker">Desarrollo Web</span>
      </h1>

      <p class="hero-lead">
        Soy {site.fullName}, desarrollador Front-End en San Luis Potosí. Construyo aplicaciones dinámicas,
        responsivas y mantenibles principalmente con Angular, Ionic.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#proyectos">
          Ver proyectos
          <i data-lucide="arrow-down-right"></i>
        </a>
        <a class="button button-secondary" href={site.cvPath} download>
          <i data-lucide="download"></i>
          Descargar CV
        </a>
      </div>
    </div>

    <!-- Foto -->
    <div class="cell cell-photo" data-aos="fade-left" data-aos-delay="100">
      <div class="photo-frame box" data-tilt>
        <img src={site.profileImage} alt={`Foto de perfil de ${site.fullName}`} width="2304" height="1536" />
        <p class="photo-tag">
          <strong>{site.fullName}</strong>
          <span>Angular, Ionic y experiencias web.</span>
        </p>
      </div>

      <div class="badge" aria-label="Disponible para proyectos">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <defs>
            <path id="badgeCircle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
          </defs>
          <text>
            <textPath href="#badgeCircle" textLength="270">DISPONIBLE ✦ PORTFOLIO 2026 ✦</textPath>
          </text>
        </svg>
        <i data-lucide="sparkles"></i>
      </div>
    </div>

    <!-- Métricas -->
    <div class="cell-metrics" aria-label="Resumen profesional">
      {
        metrics.map((metric, index) => (
          <article
            class:list={["metric box box-lift", `fill-${metricColors[index % metricColors.length]}`]}
            data-aos="zoom-in"
            data-aos-delay={index * 90}
          >
            <strong class="counter" data-target={metric.target} data-suffix={metric.suffix}>
              {metric.target}
              {metric.suffix}
            </strong>
            <span>{metric.label}</span>
          </article>
        ))
      }
    </div>

    <!-- Stack y contacto rápido -->
    <div class="cell cell-stack box" data-aos="fade-up" data-aos-delay="150">
      <p class="label">Stack principal</p>
      <div class="stack-cloud">
        {heroStack.map((item) => <span>{item}</span>)}
      </div>
      <div class="quick-links">
        <a href={`mailto:${site.email}`}>
          <i data-lucide="mail"></i>
          Correo
        </a>
        <a href={site.phoneHref}>
          <i data-lucide="phone"></i>
          Teléfono
        </a>
        <a href={site.whatsappContactUrl} target="_blank" rel="noreferrer">
          <i data-lucide="message-circle"></i>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <Marquee items={skills} color="green" tilt />
</section>

<script>
  import { initCounters } from "../scripts/counters";
  import { initTyping } from "../scripts/effects";

  initCounters();
  initTyping();
</script>

<style>
  .hero {
    padding: calc(var(--header-height) + var(--header-offset) + 36px) 0 28px;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 44px;
  }

  .cell {
    position: relative;
  }

  /* --- Titular --- */
  .cell-title {
    display: grid;
    grid-column: span 8;
    gap: 26px;
    align-content: center;
    justify-items: start;
    padding: clamp(24px, 4.4vw, 52px);
  }

  .role-line {
    min-height: 1.6em;
    white-space: nowrap;
  }

  .role-dot {
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--green);
  }

  .caret {
    width: 0.55em;
    height: 1.1em;
    margin-left: -4px;
    background: var(--ink);
    animation: blink 1s steps(1) infinite;
  }

  h1 {
    font-size: clamp(2.3rem, 10.2vw, 5.2rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  /* Subrayado tipo marcador que se "pinta" al cargar */
  .marker {
    border-radius: 0.14em;
    padding: 0 0.12em;
    margin-left: -0.12em;
    background: linear-gradient(var(--green), var(--green)) no-repeat left / 100% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: var(--on-color);
    animation: marker 900ms cubic-bezier(0.6, 0, 0.2, 1) 500ms backwards;
  }

  .hero-lead {
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* --- Foto --- */
  .cell-photo {
    grid-column: span 4;
    min-height: 380px;
  }

  .photo-frame {
    position: relative;
    overflow: hidden;
    height: 100%;
    background: var(--lilac);
    transition: transform 200ms ease;
    will-change: transform;
  }

  .photo-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% center;
  }

  .photo-tag {
    position: absolute;
    right: 14px;
    bottom: 14px;
    left: 14px;
    display: grid;
    gap: 2px;
    border: var(--bw) solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    background: var(--surface);
    color: var(--text);
    line-height: 1.3;
  }

  .photo-tag span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  /* Sello giratorio */
  .badge {
    position: absolute;
    top: -26px;
    left: -30px;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border: var(--bw) solid var(--ink);
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: var(--shadow-sm);
    color: var(--on-color);
  }

  .badge svg:first-child {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 14s linear infinite;
  }

  .badge text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .badge :global(svg.lucide) {
    width: 1.7rem;
    height: 1.7rem;
  }

  /* --- Métricas --- */
  .cell-metrics {
    display: grid;
    grid-column: span 6;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .metric {
    display: grid;
    gap: 8px;
    align-content: space-between;
    padding: 20px;
  }

  .metric:nth-child(odd):hover {
    rotate: -2deg;
  }

  .metric:nth-child(even):hover {
    rotate: 2deg;
  }

  .metric strong {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .metric span {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.25;
  }

  /* --- Stack --- */
  .cell-stack {
    display: grid;
    grid-column: span 6;
    gap: 16px;
    align-content: space-between;
    padding: 22px;
  }

  .stack-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-cloud span {
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 4px 14px;
    font-weight: 700;
    transition: background 160ms ease, color 160ms ease, rotate 160ms ease;
  }

  .stack-cloud span:hover {
    background: var(--green);
    color: var(--on-color);
    rotate: -3deg;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .quick-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: 0.92rem;
    font-weight: 700;
    transition: background 160ms ease, color 160ms ease, translate 120ms ease, box-shadow 120ms ease;
  }

  .quick-links a:hover {
    background: var(--ink);
    color: var(--bg);
    translate: 0 -2px;
  }

  @media (max-width: 980px) {
    .cell-title,
    .cell-photo,
    .cell-metrics,
    .cell-stack {
      grid-column: 1 / -1;
    }

    .cell-photo {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .badge {
      top: -22px;
      right: -6px;
      left: auto;
      width: 96px;
      height: 96px;
    }
  }

  @media (max-width: 680px) {
    .bento,
    .cell-metrics {
      gap: 14px;
    }

    .role-line {
      font-size: 0.68rem;
    }

    .hero-actions .button {
      flex: 1 1 100%;
    }

    .metric {
      padding: 14px 12px;
    }

    .metric span {
      font-size: 0.78rem;
    }

    .quick-links {
      grid-template-columns: 1fr;
    }
  }
</style>
