---
import { site } from "../data/site";
import { heroPhrases, heroStack, metrics } from "../data/skills";

const str = (value: string) => `<span class="tk-s">"${value}"</span>`;
const half = Math.ceil(heroStack.length / 2);

// Resumen del perfil presentado como un archivo TypeScript.
const codeLines = [
  `<span class="tk-k">const</span> dev = {`,
  `  nombre: ${str(site.shortName)},`,
  `  rol: ${str(site.role)},`,
  `  ubicacion: ${str(site.location)},`,
  `  stack: [`,
  `    ${heroStack.slice(0, half).map(str).join(", ")},`,
  `    ${heroStack.slice(half).map(str).join(", ")},`,
  `  ],`,
  `  disponible: <span class="tk-k">true</span>,`,
  `};`,
  ``,
  `<span class="tk-k">export default</span> dev;`,
];
---

<section id="inicio" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy" data-aos="fade-up">
      <div class="identity">
        <img src={site.profileImage} alt={`Foto de perfil de ${site.fullName}`} width="96" height="96" />
        <div>
          <strong>{site.fullName}</strong>
          <span class="status">
            <span class="status-dot" aria-hidden="true"></span>
            Disponible para proyectos
          </span>
        </div>
      </div>

      <h1>
        Experto en <span class="accent">desarrollo web</span>
      </h1>

      <p class="prompt mono">
        <span class="prompt-sign" aria-hidden="true">$</span>
        <span data-typed data-phrases={JSON.stringify(heroPhrases)}>{heroPhrases[0]}</span><span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <p class="hero-lead">
        Soy desarrollador Front-End en San Luis Potosí. Construyo aplicaciones dinámicas, responsivas y mantenibles,
        principalmente con Angular e Ionic.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#proyectos">
          Ver proyectos
          <i data-lucide="arrow-down"></i>
        </a>
        <a class="button" href={site.cvPath} download>
          <i data-lucide="download"></i>
          Descargar CV
        </a>
      </div>
    </div>

    <figure class="editor card" data-aos="fade-up" data-aos-delay="120" aria-label="Resumen del perfil en formato de código">
      <div class="editor-bar">
        <span class="editor-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="editor-tab mono">perfil.ts</span>
      </div>
      <ol class="code">
        {
          codeLines.map((line) => (
            <li>
              <code set:html={line || "&nbsp;"} />
            </li>
          ))
        }
      </ol>
    </figure>

    <dl class="metrics" data-aos="fade-up" data-aos-delay="160">
      {
        metrics.map((metric) => (
          <div class="metric">
            <dt>{metric.label}</dt>
            <dd class="counter" data-target={metric.target} data-suffix={metric.suffix ?? ""}>
              {`${metric.target}${metric.suffix ?? ""}`}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import { initCounters } from "../scripts/counters";
  import { initTyping } from "../scripts/effects";

  initTyping();
  initCounters();
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 8vw, 96px);
  }

  /* Ondas concéntricas que nacen tras la ventana de código y se desvanecen */
  .hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 88% 8%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 42%),
      repeating-radial-gradient(circle at 88% 8%, transparent 0 63px, var(--line) 63px 64px);
    content: "";
    mask-image: radial-gradient(circle at 88% 8%, #000 0%, transparent 68%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .identity img {
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .identity > div {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .identity strong {
    font-weight: 600;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-out infinite;
  }

  h1 {
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .accent {
    color: var(--accent);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 1.6em;
    color: var(--text);
    font-size: 0.9rem;
  }

  .prompt-sign {
    color: var(--accent);
  }

  .caret {
    width: 8px;
    height: 1.1em;
    margin-left: -6px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .hero-lead {
    max-width: 52ch;
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  /* Ventana de editor */
  .editor {
    overflow: hidden;
    margin: 0;
    box-shadow: var(--shadow);
  }

  .editor-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--line);
    padding: 10px 14px;
    background: var(--surface-2);
  }

  .editor-dots {
    display: inline-flex;
    gap: 6px;
  }

  .editor-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .editor-tab {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .code {
    overflow-x: auto;
    margin: 0;
    padding: 16px 0;
    list-style: none;
    counter-reset: line;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .code li {
    display: flex;
    padding-right: 18px;
    counter-increment: line;
  }

  .code li::before {
    width: 44px;
    flex: 0 0 auto;
    padding-right: 16px;
    color: var(--line-strong);
    content: counter(line);
    text-align: right;
    user-select: none;
  }

  .code code {
    font: inherit;
    white-space: pre;
  }

  .code :global(.tk-k) {
    color: var(--accent);
  }

  .code :global(.tk-s) {
    color: var(--code-string);
  }

  /* Métricas */
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column: 1 / -1;
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: 20px 24px;
  }

  .metric + .metric {
    border-left: 1px solid var(--line);
  }

  .metric:first-child {
    padding-left: 0;
  }

  .metric dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .metric dt {
    color: var(--muted);
    font-size: 0.86rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .code {
      font-size: 0.74rem;
    }

    .code li::before {
      width: 34px;
      padding-right: 12px;
    }

    .metric {
      padding: 16px 12px;
    }

    .metric dt {
      font-size: 0.76rem;
      line-height: 1.35;
    }
  }
</style>
