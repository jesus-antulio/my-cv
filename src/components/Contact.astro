---
import { site } from "../data/site";
import { heroStack } from "../data/skills";
import Marquee from "./ui/Marquee.astro";

const links = [
  { icon: "mail", label: site.email, href: `mailto:${site.email}` },
  { icon: "phone", label: site.phoneDisplay, href: site.phoneHref },
  { icon: "message-circle", label: "WhatsApp", href: site.whatsappContactUrl, external: true },
  { icon: "map-pin", label: site.location, href: site.mapsUrl, external: true },
  { icon: "download", label: "Descargar CV", href: site.cvPath, download: true },
];
---

<section id="contacto" class="contact-section">
  <Marquee items={["Hablemos", ...heroStack]} color="yellow" reverse />

  <div class="section">
    <div class="container">
      <div class="contact-card box fill-green" data-aos="zoom-in">
        <div class="contact-copy">
          <p class="sticker contact-sticker">(05) Contacto</p>
          <h2>¿Tienes un proyecto en mente? Hablemos.</h2>
          <p>
            Disponible para nuevas oportunidades frontend, colaboraciones tecnológicas y proyectos en Angular, Ionic
            y Astro.
          </p>
        </div>

        <div class="contact-links">
          {
            links.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                download={link.download}
              >
                <i data-lucide={link.icon} />
                <span class="contact-label">{link.label}</span>
                <i data-lucide="arrow-up-right" class="contact-arrow" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    overflow: hidden;
  }

  /* Dentro del bloque verde los bordes siempre van en negro */
  .contact-card {
    --ink: #111111;
    --shadow-color: #111111;
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    border-color: #111;
    padding: clamp(22px, 4.4vw, 56px);
    box-shadow: var(--shadow-lg);
  }

  :global(:root[data-theme="dark"]) .contact-card {
    box-shadow: 10px 10px 0 #f4f0e6;
  }

  /* Titular a la izquierda y texto de apoyo alineado abajo a la derecha */
  .contact-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 18px clamp(24px, 5vw, 64px);
    align-items: end;
  }

  .contact-sticker {
    grid-column: 1 / -1;
    justify-self: start;
    background: #fffdf7;
    color: #111;
  }

  .contact-copy h2 {
    font-size: clamp(2.1rem, 5.2vw, 4rem);
  }

  .contact-copy > p:last-child {
    padding-bottom: 6px;
    font-size: 1.08rem;
    font-weight: 500;
  }

  /* Rejilla alineada: 2 enlaces arriba y 3 abajo, todos del mismo alto */
  .contact-links {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-links a {
    display: flex;
    grid-column: span 2;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    border: var(--bw) solid #111;
    border-radius: var(--radius-sm);
    padding: 10px 18px;
    background: #fffdf7;
    box-shadow: 4px 4px 0 #111;
    color: #111;
    font-weight: 700;
    transition: translate 120ms ease, box-shadow 120ms ease, background 160ms ease;
  }

  .contact-links a:nth-child(-n + 2) {
    grid-column: span 3;
  }

  .contact-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-links :global(.contact-arrow) {
    margin-left: auto;
    transition: rotate 200ms ease;
  }

  .contact-links a:hover {
    background: var(--yellow);
    box-shadow: 7px 7px 0 #111;
    translate: -3px -3px;
  }

  .contact-links a:hover :global(.contact-arrow) {
    rotate: 45deg;
  }

  .contact-links a:active {
    box-shadow: 0 0 0 #111;
    translate: 4px 4px;
  }

  @media (max-width: 860px) {
    .contact-copy {
      grid-template-columns: 1fr;
    }

    .contact-links a,
    .contact-links a:nth-child(-n + 2) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .contact-links a {
      gap: 10px;
      padding: 10px 14px;
      font-size: 0.94rem;
    }
  }
</style>
