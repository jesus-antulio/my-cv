---
import { site, whatsappUrl } from "../data/site";
import { toLang, useTranslations } from "../i18n";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const { contact } = t;

const links = [
  { icon: "mail", label: site.email, href: `mailto:${site.email}` },
  { icon: "phone", label: site.phoneDisplay, href: site.phoneHref },
  { icon: "message-circle", label: "WhatsApp", href: whatsappUrl(t.whatsapp.contactMessage), external: true },
  { icon: "map-pin", label: t.meta.location, href: site.mapsUrl, external: true },
  { icon: "download", label: contact.downloadCv, href: site.cv[lang], cv: true },
];
---

<section id={t.sections.contact} class="section">
  <div class="container contact-grid">
    <div class="contact-copy" data-aos="fade-up">
      <p class="eyebrow">
        <span>05</span>
        <span class="eyebrow-sep" aria-hidden="true">/</span>
        <span>{contact.label}</span>
      </p>
      <h2>{contact.titleLead} <span class="accent">{contact.titleAccent}</span></h2>
      <p>{contact.text}</p>
    </div>

    <ul class="contact-links" data-aos="fade-up" data-aos-delay="80">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
              download={link.cv}
              hreflang={link.cv ? lang : undefined}
              data-cv-link={link.cv}
            >
              <i data-lucide={link.icon} />
              <span class="contact-label">{link.label}</span>
              <i data-lucide="arrow-up-right" class="contact-arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }

  .contact-copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 4.6vw, 3.2rem);
  }

  .accent {
    color: var(--accent);
  }

  .contact-copy > p:last-child {
    max-width: 46ch;
  }

  .contact-links {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .contact-links a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 16px 4px;
    color: var(--muted);
    transition: color 160ms ease, padding 200ms ease;
  }

  .contact-label {
    overflow-wrap: anywhere;
    color: var(--text);
    font-weight: 500;
    transition: color 160ms ease;
  }

  .contact-links a:hover {
    padding-left: 10px;
    color: var(--accent);
  }

  .contact-links a:hover .contact-label {
    color: var(--accent);
  }

  .contact-links :global(.contact-arrow) {
    opacity: 0.5;
    transition: opacity 160ms ease, translate 200ms ease;
  }

  .contact-links a:hover :global(.contact-arrow) {
    opacity: 1;
    translate: 2px -2px;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
