---
import { site } from "../data/site";
import { heroStack } from "../data/skills";
import Marquee from "./ui/Marquee.astro";

const links = [
  { icon: "mail", label: site.email, href: `mailto:${site.email}` },
  { icon: "phone", label: site.phoneDisplay, href: site.phoneHref },
  { icon: "message-circle", label: "WhatsApp", href: site.whatsappContactUrl, external: true },
  { icon: "map-pin", label: site.location, href: site.mapsUrl, external: true },
  { icon: "download", label: "Descargar CV", href: site.cvPath, download: true },
];
---

<section id="contacto" class="contact-section">
  <Marquee items={["Hablemos", ...heroStack]} color="yellow" reverse />

  <div class="section">
    <div class="container">
      <div class="contact-card box fill-green" data-aos="zoom-in">
        <div class="contact-copy">
          <p class="sticker contact-sticker">(05) Contacto</p>
          <h2>¿Tienes un proyecto en mente? Hablemos.</h2>
          <p>
            Disponible para nuevas oportunidades frontend, colaboraciones tecnológicas y proyectos en Angular, Ionic
            y Astro.
          </p>
        </div>

        <div class="contact-links">
          {
            links.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                download={link.download}
              >
                <i data-lucide={link.icon} />
                <span class="contact-label">{link.label}</span>
                <i data-lucide="arrow-up-right" class="contact-arrow" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    overflow: hidden;
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(24px, 5vw, 64px);
    box-shadow: var(--shadow-lg);
  }

  .contact-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .contact-sticker {
    background: var(--surface);
    color: var(--ink);
    animation: wobble 4s ease-in-out infinite;
  }

  :global(:root[data-theme="dark"]) .contact-sticker {
    background: #141414;
    color: #f4f0e6;
  }

  .contact-copy h2 {
    font-size: clamp(2.2rem, 5.6vw, 4.4rem);
  }

  .contact-copy > p:last-child {
    max-width: 44ch;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .contact-links {
    display: grid;
    gap: 12px;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    border: var(--bw) solid #111;
    border-radius: 999px;
    padding: 10px 20px;
    background: #fffdf7;
    box-shadow: 4px 4px 0 #111;
    color: #111;
    font-weight: 700;
    transition: translate 120ms ease, box-shadow 120ms ease, background 160ms ease;
  }

  .contact-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-links :global(.contact-arrow) {
    margin-left: auto;
    transition: rotate 200ms ease;
  }

  .contact-links a:hover {
    background: var(--yellow);
    box-shadow: 7px 7px 0 #111;
    translate: -3px -3px;
  }

  .contact-links a:hover :global(.contact-arrow) {
    rotate: 45deg;
  }

  .contact-links a:active {
    box-shadow: 0 0 0 #111;
    translate: 4px 4px;
  }

  /* Dentro del bloque verde los bordes siempre van en negro */
  .contact-card {
    --ink: #111111;
    --shadow-color: #111111;
    border-color: #111;
  }

  :global(:root[data-theme="dark"]) .contact-card {
    box-shadow: 10px 10px 0 #f4f0e6;
  }

  @media (max-width: 900px) {
    .contact-card {
      grid-template-columns: 1fr;
    }
  }
</style>
